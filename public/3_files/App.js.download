function mvc_preload()
{
	if(!mvco_app){console_log('MVC is not initialized!');}
	else if(typeof mvco_app.computed.permission_content=="undefined"){console_log('permission_content is not initialized!');}
	else if(typeof mvco_app.data.entity_label=="undefined"){console_log('entity_label is not initialized!');}
	else MVCPermission_Controller();
}
mvc_preload();

window.onbeforeunload = function()
{
	if(pop_up_window!=null){pop_up_window.close();pop_up_window=null;}
	if(global_mvc.changes.length>0)return '';
};
// MVC Manipulation [   End   ]


// Notification Manipulation [ Start ]

let noti_app=null;

noti_app = new Vue(
{
	data:
	{
		messages : [],permissions:[],
		show_messages:false, show_permissions:false
	},
	computed:{
		new_messages:function()
		{
			let self=this,n=0;
			for(let i=0;i<self.messages.length;i++)
			{
				let y=self.messages[i];
				if((new Date(y.date))>last_notify)n++;
			}
			return n;
		},
		new_permissions:function()
		{
			let self=this,n=0;
			for(let i=0;i<self.permissions.length;i++)
			{
				let y=self.permissions[i];
				if((new Date(y.date))>last_notify)n++;
			}
			return n;
		}
	},
	methods:{
		loadNotifications : function()
		{
			let self=this;
			query_get('load',function(response)
			{
				try
				{
					let noti=JSON.parse(response);
					self.receivedNotification(noti);
				}catch(e){console_log('ERROR:',e,'DATA:',response);}
			},'type=notifications');
		},
		permissionResponse : function(idx,x,r)
		{
			let self=this;
			if(!confirm("Are you sure to "+(r?"Confirm":"Reject")+"?"))return;
			
			query_get('permissionResponse&address='+encodeURI(x.address)+'&response='+r,function(response)
			{
				try
				{
					let obj=JSON.parse(response);
					console_log(obj);
					self.permissions.splice(idx,1);
				}catch(e){console_log('ERROR:',e,'DATA:',response);}
			},'type=notifications');
		},
		viewNotifications()
		{
			query_get('viewNotifications',function(response)
			{
				try
				{
					let obj=JSON.parse(response);
					//last_notify=new Date();
				}catch(e){console_log('ERROR:',e,'DATA:',response);}
			},'type=notifications');
		},
		receivedNotification : function(noti)
		{
			let self=this;let noti_=[];
			//console_log(noti);
			if(noti.messages)for(let i=0;i<noti.messages.length;i++)
			{
				let x=noti.messages[i];
				
				self.push_notifications(x,"messages");
			}
			if(noti.permissions)for(let i=0;i<noti.permissions.length;i++)
			{
				let x=noti.permissions[i];
				
				self.push_notifications(x,"permissions");
			}
			self.messages.sort(function(a,b){return new Date(b.date) - new Date(a.date);});
			self.permissions.sort(function(a,b){return new Date(b.date) - new Date(a.date);});
		},
		push_notifications : function(x,prop="messages")
		{
			let self=this;
			
			for(let i=0;i<self[prop].length;i++)
			{
				let y=self[prop][i];
				if(x.address==y.address){self[prop].splice(i,1);};
			}
			self[prop].push(x);
		}
	}
});
noti_app.$mount('.notificationApp');
noti_app.loadNotifications();

if(typeof(EventSource) !== "undefined") 
	{
		var source = new EventSource("script/core/sse.php");

		source.onmessage = function(event) {
			let data=event.data.split('data:')[0];
			let obj=JSON.parse(data);
			noti_app.receivedNotification(obj);
		}
	} else {
	
  // Sorry! No server-sent events support..
}

// Notification Manipulation  [ End ]
