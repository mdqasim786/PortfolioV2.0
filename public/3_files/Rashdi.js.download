function alertText(code, obj, duration = 3000, _title = '') {

  /* --- 1. map your “code” → title & icon ------------------------ */
  let title  = 'Alert',
      icon   = 'success';                        // default
  if (code > 0 || code === -3) { title = 'Error';        icon = 'error'; }
  else if (code === 0)          { title = '';            icon = 'success'; }
  else if (code === -1)         { title = 'Warning';     icon = 'warning'; }
  else if (code === -2)         { title = 'Information'; icon = 'info';    }
  else if (code === -4)         { title = 'Alert';       icon = 'success'; }

  if (_title) title = _title;                     // caller override

  /* --- 2. normalise the message into html/text ------------------- */
  let swalOptions = { title, icon };

  if (typeof obj === 'string') {
    // crude check: string starts with "<" => treat as HTML, else as plaintext
    if (obj.trim().startsWith('<')) swalOptions.html = obj;
    else swalOptions.text = obj;
  } else if (window.jQuery && obj instanceof jQuery) {
    swalOptions.html = obj[0].outerHTML;
  } else if (obj instanceof HTMLElement) {
    swalOptions.html = obj.outerHTML;
  } else {
    swalOptions.text = String(obj);
  }

  /* --- 3. auto‑close timer -------------------------------------- */
  if (duration !== 0) {
    swalOptions.timer            = duration;          // ms to close automatically
    swalOptions.timerProgressBar = true;              // nice progress bar
    swalOptions.showConfirmButton = false;            // no OK button when it auto‑closes
  } else {
    swalOptions.showConfirmButton = true;             // default OK button
  }

  /* --- 4. fire the alert and return its promise ------------------ */
  return Swal.fire(swalOptions);
}

