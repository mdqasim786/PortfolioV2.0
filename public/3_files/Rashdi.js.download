}

function printMode(size = 'A4 Portrait',){
	
	html= `
	<style>
		@media print {
			@page {
				size: `+size+`
			}
		}
		
		table td{
			font-size:12px;
		}

		table {border-collapse: collapse; width: 100%; font-family:arial; font-size: 12px}
	</style>
	<`+`script>setTimeout(function(){window.print();}, 500);<`+`/script>`;
	return html;
}

function printPage(html){
	if(pop_up_window!=null)pop_up_window.close();
	pop_up_window = window.open("", "myWindow", "width=400,height=600");
	if(pop_up_window)
		pop_up_window.document.write(html);
	else alertText("Window is disabled!");
	console.log(pop_up_window);
	return pop_up_window;
}

function pruneText(text,max=30) {
	return text.length > max ? text.substr(0, max) : text;
}
function removeAll(node,startfrom=0,depth=0)
{
	for(let len=node.children.length,i=len-1;i>=0;i--)removeAll(node.children[i],startfrom,depth+1);
	if(depth>=startfrom)node.remove();
}

function str_random(len) {
	var tmp='';
    for(var i = 0; i <len; i++) {
        var j = Math.floor(Math.random() * base_range.length);
        tmp+=base_range[j];
    }
    return tmp;
}

var base_range = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+-*/=`~!@#$%^&|(){}[]<>;:.,?'.split('');
function convertBase(value, from_base, to_base) {
  var from_range = base_range.slice(0, from_base);
  var to_range = base_range.slice(0, to_base);
  
  var dec_value = value.split('').reverse().reduce(function (carry, digit, index) {
    if (from_range.indexOf(digit) === -1) throw new Error('Invalid digit `'+digit+'` for base '+from_base+'.');
    return carry += from_range.indexOf(digit) * (Math.pow(from_base, index));
  }, 0);
  
  var new_value = '';
  while (dec_value > 0) {
    new_value = to_range[dec_value % to_base] + new_value;
    dec_value = (dec_value - (dec_value % to_base)) / to_base;
  }
  return new_value || '0';
}

function randPass(len=10)
{
	let tm=parseInt((new Date()-0)/1000);
	console_log(tm);
	let code=convertBase(tm+"",10,90)
	code=str_random(len-code.length)+code;
	return code;
}

var inWords_a = ['','One ','Two ','Three ','Four ', 'Five ','Six ','Seven ','Eight ','Nine ','Ten ','Eleven ','Twelve ','Thirteen ','Fourteen ','Fifteen ','Sixteen ','Seventeen ','Eighteen ','Nineteen '];
var inWords_b = ['', '', 'Twenty','Thirty','Forty','Fifty', 'Sixty','Seventy','Eighty','Ninety'];
function inWords (num) {
    if ((num = num.toString()).length > 9) return 'overflow';
    n = ('000000000' + num).substr(-9).match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
    if (!n) return; var str = '';
    str += (n[1] != 0) ? (inWords_a[Number(n[1])] || inWords_b[n[1][0]] + ' ' + inWords_a[n[1][1]]) + 'Crore ' : '';
    str += (n[2] != 0) ? (inWords_a[Number(n[2])] || inWords_b[n[2][0]] + ' ' + inWords_a[n[2][1]]) + 'Lakh ' : '';
    str += (n[3] != 0) ? (inWords_a[Number(n[3])] || inWords_b[n[3][0]] + ' ' + inWords_a[n[3][1]]) + 'Thousand ' : '';
    str += (n[4] != 0) ? (inWords_a[Number(n[4])] || inWords_b[n[4][0]] + ' ' + inWords_a[n[4][1]]) + 'Hundred ' : '';
    str += (n[5] != 0) ? ((str != '') ? 'and ' : '') + (inWords_a[Number(n[5])] || inWords_b[n[5][0]] + ' ' + inWords_a[n[5][1]]) : '';
    return str;
}

function toGeneralDate(dt=null){
	if(dt==null)dt= new Date();
	let pts = dt.toISOString().split('T')[0].split('-');
	return pts[2]+'-'+pts[1]+'-'+pts[0];
}

