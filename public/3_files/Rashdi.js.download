function time_ago(time) {

  switch (typeof time) {
    case 'number':
      break;
    case 'string':
      time = +new Date(time);
      break;
    case 'object':
      if (time.constructor === Date) time = time.getTime();
      break;
    default:
      time = +new Date();
  }
  var time_formats = [
    [60, 'seconds', 1], // 60
    [120, '1 minute ago', '1 minute from now'], // 60*2
    [3600, 'minutes', 60], // 60*60, 60
    [7200, '1 hour ago', '1 hour from now'], // 60*60*2
    [86400, 'hours', 3600], // 60*60*24, 60*60
    [172800, 'Yesterday', 'Tomorrow'], // 60*60*24*2
    [604800, 'days', 86400], // 60*60*24*7, 60*60*24
    [1209600, 'Last week', 'Next week'], // 60*60*24*7*4*2
    [2419200, 'weeks', 604800], // 60*60*24*7*4, 60*60*24*7
    [4838400, 'Last month', 'Next month'], // 60*60*24*7*4*2
    [29030400, 'months', 2419200], // 60*60*24*7*4*12, 60*60*24*7*4
    [58060800, 'Last year', 'Next year'], // 60*60*24*7*4*12*2
    [2903040000, 'years', 29030400], // 60*60*24*7*4*12*100, 60*60*24*7*4*12
    [5806080000, 'Last century', 'Next century'], // 60*60*24*7*4*12*100*2
    [58060800000, 'centuries', 2903040000] // 60*60*24*7*4*12*100*20, 60*60*24*7*4*12*100
  ];
  var seconds = (+new Date() - time) / 1000,
    token = 'ago',
    list_choice = 1;

  if (seconds == 0) {
    return 'Just now'
  }
  if (seconds < 0) {
    seconds = Math.abs(seconds);
    token = 'from now';
    list_choice = 2;
  }
  var i = 0,
    format;
  while (format = time_formats[i++])
    if (seconds < format[0]) {
      if (typeof format[2] == 'string')
        return format[list_choice];
      else
        return Math.floor(seconds / format[2]) + ' ' + format[1] + ' ' + token;
    }
  return time;
}

function numberToword(num){
	let oneth = ["","one","two", "three", "four", "five", "six", "seven", "eight", "nine"];
	let tenth = ["","ten","twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"];
	let teenth = ["", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"];
	let correct=Math.abs(parseInt(num));
	let str=(correct?correct:"")+"";
	let teen=false;
	
	let words= "";
	for(let len=str.length,i=len-1;i>=0;i--){
		let num=parseInt(str[len-(i+1)]);
		
		if(i==1 || i==4){// Tenth
		    if(num==0);
			else if(num==1 && parseInt(str[len-(i)])>0)teen=true;
			else words+=tenth[num]+" ";
		}else {//Oneth
		  if(num>0){
			if(teen)words+=teenth[num]+" ";
			else words+=oneth[num]+" ";
		  }
			teen=false;
			
			if(i==2)words+="hundred ";
			if(i==3)words+="thousand ";
		}
	}
	return words;
}

function copyText(that)
{
	that.select();
	that.setSelectionRange(0, 99999);
	
	document.execCommand("copy");
	alert("Successfully Copied");
}


//Component Manager

function GS(color)
{
	let col=parseInt(color);
	let b=col%256;col=parseInt(col/256);
	let g=col%256;col=parseInt(col/256);
	let r=col;
	//let gs=parseInt((255-r)*0.299)+parseInt((255-g)*0.587)+parseInt((255-b)*0.11);
	return ((255-r)<16?'0':'')+(255-r).toString(16)+((255-g)<16?'0':'')+(255-g).toString(16)+((255-b)<16?'0':'')+(255-b).toString(16);
}

function get_from(arr,id, attr='id'){
	let self=this;
	for(let i=0; i<arr.length;i++){
		let x = arr[i];
		if(typeof attr == "object" && attr.length>0){
			let OK=true;
			for(let a=0;a<attr.length;a++)
				if(x[attr[a]]!=id[attr[a]])OK=false;
			if(OK)return x;
		}
		else if(x[attr]==id)return x;
	}
	return null;
}

function compareObject(obj1,obj2){
	
	// If null then direct return
	if(!obj1 && obj1==obj2)return true;
	
	let k1=Object.keys(obj1), k2 = Object.keys(obj2);
	if(k1.length!=k2.length)return false;
	for(let n=0;n<k1.length;n++){
		let x=obj1[k1[n]], y=obj2[k2[n]];
		if(x!=y)return false;
	}
	return true;
}

function inArray(x,arr,prop){
	for(let n=0;n<arr.length;n++)
		if(x[prop]==arr[n][prop])return arr[n];
	return null;
}

function includesArray(arr,x,prop){
	let ret=[];
	for(let n=0;n<arr.length;n++)
		if(x[prop]==arr[n][prop])ret.push(arr[n]);
	return ret;
}

function select_distinct(arr, prop){
	let ret=[];
	for(let n=0;n<arr.length;n++){
		let x=arr[n];
		if(insideArray(ret,x, prop)==-1)ret.push(x);
	}
	return ret;
}

function insideArray(arr,x,  prop=null){
	for(let n=0;n<arr.length;n++){
		if(prop!=null){
			if(x[prop]==arr[n][prop]){return n;}
		}else if(x==arr[n]){return n;}
	}
		
	return -1;
}

function findIndexFromProp(arr,x,  prop=null){
	for(let n=0;n<arr.length;n++){
		if(prop!=null){
			if(x==arr[n][prop]){return n;}
		}else if(x==arr[n]){return n;}
	}
		
	return -1;
}

function pushdistinctArray(arr,x){
	if(insideArray(arr,x)==-1 ){
		arr.push(x); return true
	}
	return false;
}

function removefromArray(arr,x){
	let in_array=false;
	for(let n=0;n<arr.length;n++)
		if(x==arr[n]){arr.splice(n,1);return true;}

	return false;
}

function findIndexFromID(arr,id){
    for(let i=0;i<arr.length;i++){
        if(arr[i].id==id)return i;
    }
    return -1;
}

