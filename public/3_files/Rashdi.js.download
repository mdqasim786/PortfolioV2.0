function getPositionXY(element) 
{ 
    var rect = element.getBoundingClientRect(); 
   return 'X: ' + rect.x + ', ' + 'Y: ' + rect.y;
} 

function getParameterByName(name, url) {
	if (!url) url = window.location.href;
	name = name.replace(/[\[\]]/g, '\\$&');
	var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
	results = regex.exec(url);
	if (!results) return null;
	if (!results[2]) return '';
	return decodeURIComponent(results[2].replace(/\+/g, ' '));
}
//Part of System WebSite ,It heart of Program

function getCategory(){
	var cat=getParameterByName('cat');
	if(cat)return cat;
	
	let tmp = window.location.href.split("/category/");
	if(tmp.length >= 2){
		return tmp[1].split('?')[0];
	}
	return null;
}

function getRuntime(inp=null) {
	
	if(inp!=null)return document.location.origin+'/Runtime.php?'+inp;
	
	let tmp = window.location.href.split("/page/");
	if(tmp.length >= 2){
		var act = tmp[1].split('?')[0]
		return document.location.origin+'/Runtime.php?action='+act;
	}
	
	tmp = window.location.href.split("/category/");
	if(tmp.length >= 2){
		var cat = tmp[1].split('?')[0]
		return document.location.origin+'/Runtime.php?cat='+cat;
	}
	
	var act=getParameterByName('action');
	var cat=getParameterByName('cat');
	if(act)return 'Runtime.php?action='+act;
	else if(cat)return 'Runtime.php?cat='+cat;
	
}

function makeHierarchy(data, groups, leafs, dd=null){
    let date_filter = false;
    
    if(dd!=null && (dd.type!='' && dd.start!='' && dd.end!='') )date_filter = true;
    
    
    let root = {nodes: {}, data: {}};
    for(let len=data.length, i=0;i<len;i++){
        let d=data[i];
        if(date_filter){
            let dte = new Date(d[dd.type]), s=new Date(dd.start), e= new Date(dd.end);
            if( dte< s || dte>e)continue;
        }
        let tmp= root;
        
        for(let g_len=groups.length,g=0;g<g_len;g++){
            let group = d[groups[g]];
            
            if(!tmp.nodes[group])
            {
                tmp.nodes[group]={nodes: {}, data: {} };
				if(g+1 == g_len)tmp.nodes[group].value = d;
            }
            
            
            for(let l_len=leafs.length, l=0;l<l_len;l++){
                let leaf = leafs[l];
                let nd = tmp.nodes[group].data;
                if(!nd[leaf]) nd[leaf]=0;
                nd[leaf]+=parseInt(d[leaf]);
                
            }
            tmp=tmp.nodes[group];
        }
    }
    return root;
}


function readURL(input,utype,success_callback,obj={}) 
{
	let form_data = new FormData();
	let keys=Object.keys(obj);
	for(let i=0;i<keys.length;i++){
		form_data.append(keys[i],obj[keys[i]]);
	}
	if (input.files && input.files[0]) 
	{
		var file_data = input.files[0];   
		                 
		form_data.append('file', file_data);
		form_data.append('utype', utype);
		//form_data.append('uid', 1);
		$.ajax({
			url: document.location.origin+'/upload.php', // point to server-side PHP script 
			dataType: 'text',  // what to expect back from the PHP script, if anything
			cache: false,
			contentType: false,
			processData: false,
			data: form_data,                         
			type: 'post',
			success: function(php_script_response){
				try{
				let obj=JSON.parse(php_script_response);
				
				if(obj.error_code==0){
					$("#previmg")
					.attr("src", obj.message);//URL.createObjectURL(input.files[0])
					$("#percentage").html("");
					if(success_callback)success_callback(obj.message);
				}else {
					$("#percentage").html(obj.error);
					
				}
				}catch(e){console.log(php_script_response, form_data, e);}
			},
			uploadProgress: function(event, position, total, percentComplete) {
				$("#percentage").html(percentComplete+"%");
			}
		});
	}
}

Number.prototype.zeroPad = Number.prototype.zeroPad || function(base)
{
	var nr=this, len=(String(base).length - String(nr).length)+1;
	return len >0 ? new Array(len).join('0')+nr:nr;
}

/**
 * Flexible, time‑zone‑proof date formatter
 *
 * @param {string|null} iso     '2025-06-17' | '2025-06-17T14:35:00Z' | null (=now)
 * @param {object}      opts
 *        {boolean} withDay     – include the day number          (default true)
 *        {boolean} withTime    – include HH:MM (24‑h, UTC)       (default false)
 *        {string}  locale      – e.g. 'en-GB', 'fr-FR'           (default 'en-GB')
 *        {boolean} hour12      – true → 02:35 PM, false → 14:35  (default false)
 * @returns {string}
 */
function prettyDate(iso = null, {
  withDay  = true,
  withTime = false,
  locale   = 'en-GB',
  hour12   = false
} = {}) {

  /* ---------- build a UTC Date object without touching local time ---------- */
  let d;
  if (iso) {
    // If only YYYY-MM-DD given, add T00:00:00Z so we have a valid UTC ISO
    if (/^\d{4}-\d{2}-\d{2}$/.test(iso)) iso += 'T00:00:00Z';
    d = new Date(iso);                     // ISO with explicit Z stays in UTC
  } else {
    const now = new Date();
    d = new Date(Date.UTC(
      now.getUTCFullYear(),
      now.getUTCMonth(),
      now.getUTCDate(),
      now.getUTCHours(),
      now.getUTCMinutes()
    ));
  }

  /* ---------------------- build Intl options dynamically ------------------- */
  const opts = {
    year:   'numeric',
    month:  'long',
    timeZone: 'UTC'
  };
  if (withDay)  opts.day   = '2-digit';
  if (withTime) {
    opts.hour   = '2-digit';
    opts.minute = '2-digit';
    opts.hour12 = hour12;
  }

  const parts = new Intl.DateTimeFormat(locale, opts).formatToParts(d);
  const get = (type) => parts.find(p => p.type === type)?.value || '';

  /* ---------------------------- compose output ----------------------------- */
  let result = '';

  if (withDay) {
    result += `${get('day')} ${get('month')}, ${get('year')}`;
  } else {
    result += `${get('month')} ${get('year')}`;
  }

  if (withTime) {
    const time = `${get('hour')}:${get('minute')}${hour12 ? ` ${get('dayPeriod')}` : ''}`;
    result += `  ${time}`;                 // two NBSPs between date and time
  }

  return result.trim();
}

