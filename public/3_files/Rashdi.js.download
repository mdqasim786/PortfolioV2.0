function startSubscription(vapidPublicKey, email){
	let domain = window.location.origin;
	console.log(vapidPublicKey);
	if ('serviceWorker' in navigator && 'PushManager' in window) {
	  navigator.serviceWorker.register(domain+'/script/core/controller/vapid/vapid.js').then(swReg => {
		Notification.requestPermission().then(permission => {
		  if (permission === 'granted') {
			swReg.pushManager.subscribe({
			  userVisibleOnly: true,
			  applicationServerKey: urlBase64ToUint8Array(vapidPublicKey)
			}).then(subscription => {
			  
				let fm = new FormData();
				fm.append('method', 'save-subscription');
				fm.append('email', email);
				fm.append('subscription', JSON.stringify(subscription));
				fetch(domain+'/script/core/controller/vapid/subscribe.php', {
				  method: 'POST',
				  body: fm
				}).then(function(rsp){
					return rsp.text();
				}).then(function(data){console.log(data);});
			});
		  }
		});
	  });
	}
}

function urlBase64ToUint8Array(base64String) {
  const padding = '='.repeat((4 - base64String.length % 4) % 4);
  const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
  const rawData = atob(base64);
  return new Uint8Array([...rawData].map(char => char.charCodeAt(0)));
}

function loadRashdiScript(method, callback){
	query_post(method, {}, function(rsp, s){
		callback(rsp, s);
