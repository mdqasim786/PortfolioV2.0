	if(typeof str=="string" && str.length==6);
	else if(typeof str=="string"  && str.length>0 && isNum)return parseInt(str);
	return str;
}*/
// MVC Manipulation [  Start  ]
function mvc_component(input_tag,mvc_obj)
{
	if(!mvc_obj.props)mvc_obj.props=[];
	mvc_obj.props.push('data','prop','condition', 'update_callback');
	
	if(!mvc_obj.dta)mvc_obj.dta={};
	mvc_obj.dta.can_change=true;
	mvc_obj.data=function(){return JSON.parse(JSON.stringify(mvc_obj.dta));};
	
	mvc_obj.beforeDestroy = function(){
		
	};
	mvc_obj.methods.repairType = function(dta)
	{
		/*if(!global_mvc.attrs)return dta;
		let self=this,d=dta;
		let _type="string",toks=self.prop.split("_"), prp=toks[toks.length-1];
		for(let i=0,len=global_mvc.attrs.length;i<len;i++){
			let x=global_mvc.attrs[i];
			if(x.name==prp){_type=typeof x.dflt;break;}
		}
		if(_type=="integer")d=parseInt(dta);*/
		return dta;
	};
	mvc_obj.methods.settoProp = function(dta)
	{
		let self=this;
		self.data[self.prop]=self.repairType(dta);
	};
	mvc_obj.methods.getfromProp = function()
	{
		let self=this;//if(!self.data)self.data=global_mvc;
		return self.data[self.prop];
	};
	mvc_obj.methods.inCondition = function(params)
	{
		let len=params.length;
		let self=this;if(!self.condition || params.length==0)return 0;
		
		let done=1;
		for(let i=0;i<len;i++)if( !self.condition.startsWith(params[i]) )done=0;
		return len*done;
	};
	mvc_obj.render = function(ce)
	{
		let self=this;let app=global_mvc;
		if(!self.data){
			self.data=global_mvc;
			self.condition="insert";
		}
		if(global_mvc && self.data == global_mvc.sup)self.condition="insert";
		if( (self.inCondition(['insert']) || !app) || (app.permission.state<2 && self.data.temp && self.data.temp[self.prop]) )
		{
			let obj={};
			obj.on={
				dblclick:function(event){if(!(self.inCondition(['insert']) || !app))self.data.temp[self.prop]=false;self.eventManager(event);},
				keyup:function(event){if(!(self.inCondition(['insert']) || !app) && event.keyCode==13)self.data.temp[self.prop]=false;self.eventManager(event);}
			  };
			
			
			obj.on.beforeinput=function(event){self.can_change=!self.update_callback || typeof self.update_callback!="function" || self.update_callback(self,event);self.eventManager(event);};
			obj.on.input = function (event) {
				self.can_change=!self.update_callback || typeof self.update_callback!="function" || self.update_callback(self,event);
				if(!self.typed)
				{
					if(self.can_change){self.settoProp(event.target.value);}
					else event.target.value=self.getfromProp();
				}
				self.eventManager(event);
			};
			obj.on.change=function(event){if(!(self.inCondition(['insert']) || !app) && self.can_change){self.data.temp.changed=true;} self.eventManager(event);};
				
			
			let root_=ce('input',obj);
			if(!self.dynamicInput)console_log("dynamicInput function not found!");
			else self.dynamicInput(root_,ce);
			return root_;
		}
		else {
			let obj={};
			if(self.data.temp)obj.on={
				dblclick:function(event){if(app.permission.state<2)self.data.temp[self.prop]=true;},
				touchstart:function(event){event.target.tstart=new Date();},
				touchend:function(event){if(event.target.tstart && ((new Date())-event.target.tstart)<500 ){self.data.temp[self.prop]=true;}event.target.tstart=null;}
			  };
			let root_=ce('span',obj);
			if(!self.staticInput)console_log("staticInput function not found!");
			else self.staticInput(root_,ce);
			return root_;
		}
	};
	Vue.component(input_tag,mvc_obj);
}

function mvc_component_wtyped(input_tag,mvc_obj)
//window.mvc_component=function (mvc_obj)
{
	if(!mvc_obj.props)mvc_obj.props=[];
	mvc_obj.props.push('data','prop','condition', 'update_callback');
	
	if(!mvc_obj.dta)mvc_obj.dta={};
    mvc_obj.dta.can_change=true;
	mvc_obj.dta.typed='';
	mvc_obj.dta.focus=false;
	mvc_obj.dta.previous=null;
	mvc_obj.data=function(){return JSON.parse(JSON.stringify(mvc_obj.dta));};
    mvc_obj.created = function()
    {
		this.reload();
	};
	mvc_obj.methods.reload = function()
	{
		this.loadProp();
	};
    
	mvc_obj.methods.loadProp = function()
	{
		let self=this;
        if(!self.typed)
			self.typed=self.data[self.prop];
    };
    mvc_obj.methods.saveProp = function()
	{
		let self=this;
		
		self.data[self.prop]=self.typed;
        if(!self.inCondition(['insert']))self.data.temp[self.prop]=false;
	};
	mvc_obj.methods.repairType = function(dta)
	{
		if(!global_mvc.attrs)return dta;
		let self=this,d=dta;
		let _type="string",toks=self.prop.split("_"), prp=toks[toks.length-1];
		for(let i=0,len=global_mvc.attrs.length;i<len;i++){
			let x=global_mvc.attrs[i];
			if(x.name==prp){_type=typeof x.dflt;break;}
		}
		if(_type=="integer")d=parseInt(dta);
		return d;
	};
	mvc_obj.methods.settoProp = function(dta)
	{
        let self=this,d=self.repairType(dta);
        self['typed']=d;
	};
	mvc_obj.methods.getfromProp = function()
	{
        let self=this;
        return self['typed'];
	};
	mvc_obj.methods.check_preChange = function(event)
	{
		let self=this;
		return !self.update_callback || typeof self.update_callback!="function" || self.update_callback(self,event);
	};
	mvc_obj.methods.inCondition = function(params)
	{
		let len=params.length;
		let self=this;if(!self.condition || params.length==0)return 0;
		
		let done=1;
		for(let i=0;i<len;i++)if( !self.condition.startsWith(params[i]) )done=0;
		return len*done;
	};
	mvc_obj.render = function(ce)
	{
		let self=this, app=global_mvc;
		
		if(!self.data){
			self.data=global_mvc;
			self.condition="insert";
		}
		if(global_mvc && self.data == global_mvc.sup)self.condition="insert";
		if(self.data[self.prop]!=self.previous){self.typed=self.data[self.prop];self.previous=self.data[self.prop];}
		
		if(self.inCondition(['insert']) || (app.permission.state<2 && self.data.temp && self.data.temp[self.prop]) )
		{
			let obj={};
			obj.on={
				dblclick:function(event){self.saveProp();self.eventManager(event);},
				keyup:function(event){if(event.keyCode==13)self.saveProp();self.eventManager(event);}
				,focus:function(event){self.focus=true;self.eventManager(event);},focusout:function(event){self.saveProp();self.focus=false;self.eventManager(event);}
			};
			
			
			obj.on.beforeinput=function(event){self.can_change=self.check_preChange(event);self.eventManager(event);};
			obj.on.input = function (event) {
				self.can_change=self.check_preChange(event);
                if(self.can_change){self.settoProp(event.target.value);}
                else event.target.value=self.getfromProp();
				self.eventManager(event);
			};
			obj.on.change=function(event){if(!self.inCondition(['insert']) && self.can_change)self.data.temp.changed=true;self.eventManager(event);};
				
			
			let root_=ce('input',obj);
			if(!self.dynamicInput)console.log("dynamicInput function not found!");
			else self.dynamicInput(root_,ce,obj);
			return root_;
		}
		else {
			let obj={};
			if(self.data.temp)obj.on={
				dblclick:function(event){if(app.permission.state<2)self.data.temp[self.prop]=true;},
				touchstart:function(event){event.target.tstart=new Date();},
				touchend:function(event){if(event.target.tstart && ((new Date())-event.target.tstart)<500 ){self.data.temp[self.prop]=true;}event.target.tstart=null;}
			  };
			let root_=ce('span',obj);
			if(!self.staticInput)console.log("staticInput function not found!");
			else self.staticInput(root_,ce);
			return root_;
		}
	};
	//return mvc_obj;
	Vue.component(input_tag,mvc_obj);
}

class skipOption
{
	constructor(){
		this.node =null;
		this.permit= false;
	}

	addAdverstisement(time=5,event=null)
	{
		let self=this;
		console.log('#1 ',self.permit);
		if(self.permit){self.permit=false;return true;}
		if(event!=null)event.preventDefault();

		let node=$(`<div class="row" style="position:fixed;width:60%;height:40%;left:30%;top:20%;z-index:2;text-align:center;font-size:100%;">
			<div class="col-md-8"></div><div class="col-md-4"><button disabled class="btn btn-success skip_ad"></button></div>
			<div class="col-md-12">
				<img height="100%" src="">
			</div>
		</div>`);
		this.node=node[0];
		console.log('A ',self.node);
		$('body').append(node);

		this.AdTimer(event?event.target:null,time);
		return false;
	}

	askWindow(msg, inps, response_callback){
		let self=this;
		console.log('#1 ',self.permit);
		if(self.permit){self.permit=false;return true;}
		if(event!=null)event.preventDefault();

		let html = `<div style="border: solid; background-color: white;position:fixed;width:60%;height:40%;left:30%;top:20%;z-index:2;text-align:center;font-size:100%;">
			<table width="100%" border="0">
				<tr><td width="20%"></td><td width="60%">`+msg+`</td><td width="20%"></td></tr>`;
		for(let i=0;i<inps.length;i++){
			let inp = inps[i];
			
			let fixed_options =  'class="askWindow_input" name="input_'+i+'"';
			let option_field = '<input type="'+inp.type+'"'+fixed_options+'/>';
			if(inp.type=="select"){
				option_field = '<select '+fixed_options+'/>';
				for(let j=0;j<inp.options.length;j++){let opt=inp.options[j]; option_field +='<option value="'+opt.id+'">'+opt.name+'</option>';}
				option_field+= '</select>';
			}
			html+=`<tr><td>`+inp.label+`</td><td>`+option_field+`</td><td></td></tr>`;
		}
		
		html+=`<tr><td></td><td></td><td><button class="askWindow_submit">Done</button></td></tr>
		</table>
		</div>`;
		
		let node=$(html);
		self.node=node[0];
		let _submit = node.find(".askWindow_submit");
		
		let tmp = node.find(".askWindow_input");
		let submit_data = function(){
			let values = []; for(let j=0;j<tmp.length;j++)values.push(tmp[j].value);
			removeAll(self.node);self.node=null;
			response_callback(values);
		};
		_submit.click(submit_data);
		$(tmp[tmp.length-1]).keyup(function(e){ 
			var code = e.key; // recommended to use e.key, it's normalized across devices and languages
			if(code==="Enter")submit_data(e);
		});
		$('body').append(node);
		
		return false;
	}
	
	AdTimer(elm,time=5){
		let self=this;
		
		let skip=self.node.getElementsByClassName('skip_ad')[0];
		
		skip.innerText=time>0? ('After '+time): 'Skip Ad';
		if(time>0)
			setTimeout(function(t){self.AdTimer(elm,t);},1000,time-1);
		else {
			skip.disabled=null;
			skip.onclick= function(){
				console.log('On Click');
				removeAll(self.node);this.node=null;
				self.permit=true;
				if(elm)elm.click();
			}
		}
	}
};

const SR_stringToRegex = str => {
    // Main regex
    const main = str.match(/\/(.+)\/.*/)[1]
    
    // Regex options
    const options = str.match(/\/.+\/(.*)/)[1]
    
    // Compiled regex
    return new RegExp(main, options)
}
function SR_beforeValue(e) {
  let next_char = event.data;
  e.target.correctText = 0;
  let val= e.target.value;
  e.target.prevText = val;
  
  if(!next_char){return false;}
  let pat =  SR_stringToRegex(e.target.pattern);
  
  let next_str= val+next_char;
  let res = next_str.match(pat);
  
  if(!res) e.target.correctText=1;
}

function SR_afterValue(e) {
  if(e.target.correctText==1)
	  e.target.value = e.target.prevText;
}
function SRM_initialize(){
	let elementsArray = document.querySelectorAll(".masking");
	elementsArray.forEach(function(input) {
		if(!input.haveEvent){
			input.addEventListener('beforeinput', SR_beforeValue);
			input.addEventListener('input', SR_afterValue);
			input.haveEvent = true;
		}
	});
}


window.onbeforeunload = function()
{
	if(pop_up_window!=null){pop_up_window.close();pop_up_window=null;}
};

const toDataUrl = async function (url, callback) {
        //Convert to base64
        return new Promise((resolve, reject) => {
          var xhr = new XMLHttpRequest();
          xhr.onload = function () {
            var reader = new FileReader();
            reader.onloadend = function () {
              resolve(reader.result);
            };
            reader.readAsDataURL(xhr.response);
          };
          xhr.onerror = () => {
            reject({
              status: this.status,
              statusText: xhr.statusText,
            });
          };
          xhr.open("GET", url);
          xhr.responseType = "blob";
          xhr.send();
        });
};
	
function downloadPdf(html, orientation, mode='print', elm_callback){
    //mode print or pdf
    var hiddenElementId = "hidden-element";

    // Check if the hidden element with the specified ID exists
    var hiddenElement = document.getElementById(hiddenElementId);

    if(mode=='pdf'){
        if (!hiddenElement) {
            // If the element doesn't exist, create it
            hiddenElement = document.createElement("div");
            hiddenElement.id = hiddenElementId;
            hiddenElement.style.display = "none"; // Hide the element

            let doc = document.createElement("html");
            hiddenElement.appendChild(doc);
            document.body.appendChild(hiddenElement); // Insert it into the body
        }
        hiddenElement = hiddenElement.children[0];

        hiddenElement.innerHTML = html;
    }else {
        if(pop_up_window!=null)pop_up_window.close();
        pop_up_window = window.open("", "myWindow", "width=400,height=600");
        if(pop_up_window){
            pop_up_window.document.write(html);
            hiddenElement = pop_up_window.document;
        }
            
        else alertText("Window is disabled!");
        
    }    

    setTimeout(function(){
        elm_callback(hiddenElement);

        if(mode=='pdf'){ // For PDF
            const elements = hiddenElement.querySelectorAll('*');
            elements.forEach(td => {
                if(td.style.borderLeftWidth=='1px'){
                    td.style.borderLeftWidth = '2px';
                }
                if(td.style.borderRightWidth=='1px'){
                    td.style.borderRightWidth = '2px';
                }
                if(td.style.borderTopWidth=='1px'){
                    td.style.borderTopWidth = '2px';
                }
                if(td.style.borderBottomWidth=='1px'){
                    td.style.borderBottomWidth = '2px';
                }
                // Set individual border widths
            // td.style.borderTopWidth = '2px';    // Set top border width
                //td.style.borderRightWidth = '3px';  // Set right border width
                //td.style.borderBottomWidth = '4px'; // Set bottom border width
                //td.style.borderLeftWidth = '1px';   // Set left border width
            });
			
			const imgElements = hiddenElement.querySelectorAll('img');

			// Filter out img elements with non-base64 src attributes.
			const nonBase64Images = [...imgElements].filter(img => {
				const src = img.getAttribute('src');
				// Check if src is not a base64-encoded image (doesn't start with 'data:image').
				return !src || !src.startsWith('data:image');
			});
			console.log(nonBase64Images);

            const options = {
                margin: 1,
                filename: 'DOC.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { dpi: 192,scale: 1,useCORS: true },
                //html2canvas:  {  letterRendering: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: orientation },
            };

            // Use html2pdf to convert HTML to PDF
            html2pdf(hiddenElement,options);
        }else { // For print 
    
        }
        

    },500);
}